# Copy to .env.local and fill in. NEVER commit .env.local.

# Neon Postgres connection string (neon.tech -> your project -> Connection Details).
# Use the pooled connection string. (Netlify DB users: NETLIFY_DATABASE_URL is
# read automatically as a fallback.)
DATABASE_URL=

# Better Auth — secret for signing sessions (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Public base URL of the site (used for magic-link callback URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (API Keys) — sends magic-link + summary/reminder emails
RESEND_API_KEY=
EMAIL_FROM="Survivor Pool <onboarding@resend.dev>"

# Shared secret guarding any HTTP-triggerable job route
CRON_SECRET=
